<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS + iisnode — configuración del API en producción (SmarterASP).

  Va en la RAÍZ del backend, y esa carpeta se convierte en una "aplicación"
  de IIS montada en /api del sitio de app.comercializadoravida.com. Así el
  API queda en el mismo origen que el panel: hereda su certificado, no hay
  CORS y el mixed content es imposible por construcción.

  Verificación después de montarlo:
    https://app.comercializadoravida.com/api/health  ->  {"status":"ok","db":"ok",...}
  Si eso devuelve el HTML del panel, la aplicación IIS no quedó creada (lo
  está atendiendo el sitio del frontend). Si devuelve 404 pero /health sí
  responde, iisnode está recortando el prefijo /api: ver la nota al final.
-->
<configuration>
  <system.webServer>

    <!-- iisnode ejecuta el proceso Node. La entrada es iisnode.cjs (CommonJS):
         iisnode carga la entrada con require() y src/app.js es un módulo ES con
         await de nivel superior, que require() no puede cargar (daba 500). -->
    <handlers>
      <add name="iisnode" path="iisnode.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Todo lo que entre por /api lo atiende Node: endpoints, y también
             las imágenes de /api/uploads (las sirve @fastify/static). -->
        <rule name="api-node">
          <match url=".*" />
          <action type="Rewrite" url="iisnode.cjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- IMPORTANTE: el módulo WebSocket de IIS tiene que estar APAGADO para
         que el upgrade lo maneje Node (@fastify/websocket). Con esto activo
         IIS intercepta la conexión y el WS del panel y de las apps no conecta
         (el tracking en vivo del repartidor deja de actualizar). -->
    <webSocket enabled="false" />

    <!-- Que IIS deje pasar tal cual las respuestas de error de Node (401, 403,
         409, 422…). Sin esto las reemplaza por su página HTML "Server Error" y
         el panel pierde el mensaje JSON ({ error: '…' }) que debe mostrar. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- node_modules no se sirve como estático -->
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- watchedFiles: al cambiar cualquiera de estos archivos iisnode reinicia
         Node solo. Los comodines no bajan a subcarpetas, por eso van una por
         una: sin ellas, subir un controlador por FTP no surtía efecto hasta
         reiniciar el sitio. Para forzar un reinicio basta con volver a subir
         web.config. -->
    <iisnode
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;*.cjs;.env;src\*.js;src\config\*.js;src\controllers\*.js;src\controllers\delivery\*.js;src\db\*.js;src\domain\*.js;src\middlewares\*.js;src\routes\*.js;src\services\*.js;src\ws\*.js"
      loggingEnabled="true"
      devErrorsEnabled="false"
      logDirectory="iisnode" />

  </system.webServer>
</configuration>

<!--
  NOTA sobre el prefijo /api
  ─────────────────────────
  Las rutas de Fastify están registradas con prefix '/api' (backend/src/app.js),
  así que este montaje funciona si iisnode le pasa a Node la URL completa
  ("/api/auth/login"), que es lo normal.

  Si al probar /api/health da 404 y en cambio /health responde, entonces iisnode
  está recortando el prefijo. En ese caso, agregar dentro de <rules> y ANTES de
  la regla "api-node":

    <rule name="reponer-prefijo-api" stopProcessing="false">
      <match url="^(?!api/)(.*)$" />
      <action type="Rewrite" url="api/{R:1}" />
    </rule>

  El health check está expuesto a propósito en las dos rutas (/health y
  /api/health) justamente para poder distinguir cuál de los dos casos es.
-->
