# ─────────────────────────────────────────────────────────────
# Base de datos (SQL Server)
# ─────────────────────────────────────────────────────────────
DB_SERVER=localhost
DB_DATABASE=POS_VENEZUELA
DB_USER=sa
DB_PASSWORD=TU_PASSWORD_AQUI
DB_PORT=1433

# ─────────────────────────────────────────────────────────────
# Seguridad
# ─────────────────────────────────────────────────────────────
# OBLIGATORIO en producción: 32+ caracteres, aleatorio y secreto.
# Si falta o es débil (o es el valor de desarrollo), el servidor NO arranca
# en producción.
JWT_SECRET=pos_venezuela_secret_minimo_32_caracteres_aqui
JWT_EXPIRES_IN=15m

# Secreto del audit log (HMAC-SHA256). Mínimo 32 caracteres.
# Si cambia, las firmas anteriores dejan de verificar — no rotarlo a la ligera.
AUDIT_SECRET=cambiar_por_secreto_de_32_caracteres_minimo

# ─────────────────────────────────────────────────────────────
# Entorno y URLs
# ─────────────────────────────────────────────────────────────
PORT=3001
# 'production' activa el hardening (JWT obligatorio, logs reducidos, etc.)
NODE_ENV=development

# URL pública del frontend web — usada para CORS y para los links de los
# correos (invitación/registro). Prioridad al armar el link:
#   1) este FRONTEND_URL (si está, manda)
#   2) si NODE_ENV != production  → http://localhost:5173 automático
#   3) en producción → el valor de VIDA_CONFIGURACION.URL_SISTEMA
# En local puedes dejarlo vacío; en producción ponlo o define URL_SISTEMA en BD.
FRONTEND_URL=http://localhost:5173

# URL pública del backend — links de confirmación de email y callbacks OAuth.
# En producción debe ser el dominio real (https://api.tudominio.com)
BASE_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# Google Sign-In (login del cliente)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=tu_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
# Opcional: client id de Android para validar el login nativo de la app
GOOGLE_ANDROID_CLIENT_ID=
