# Copiar a .env y ajustar. Expo carga este archivo automáticamente (SDK 49+).
# En dispositivo físico usa la IP LAN de tu máquina o un túnel (ngrok, cloudflared).
EXPO_PUBLIC_API_URL=http://192.168.8.7:3001/api
EXPO_PUBLIC_WS_URL=ws://192.168.8.7:3001/api/ws
EXPO_PUBLIC_ID_BRANCH=1
EXPO_PUBLIC_ID_CUENTA=1
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
