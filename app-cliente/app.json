{
  "expo": {
    "name": "VIDA Compras",
    "slug": "vida-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A6A9A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vida.cliente",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para calcular la distancia a las sucursales y para que el repartidor pueda entregarte el pedido."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A6A9A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vida.cliente",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyARju17HZImuM-k-CQklgPmS6u4vt2Vg2I"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Necesitamos tu ubicación para el seguimiento del pedido."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para adjuntar el comprobante de pago."
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "scheme": "vida-cliente",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43759832-99f1-4e6c-9381-1915794facbe"
      }
    }
  }
}
