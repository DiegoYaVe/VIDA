# Copiar a .env y ajustar. Expo carga este archivo automáticamente (SDK 49+).
# Solo aplica a `expo start` local (dev build); los APKs de EAS usan el env de eas.json.
# Backend local: usa la IP LAN de tu máquina. Backend de producción: la URL pública.
EXPO_PUBLIC_API_URL=http://israceballos-001-site18.mtempurl.com/api
EXPO_PUBLIC_WS_URL=ws://israceballos-001-site18.mtempurl.com/api/ws
EXPO_PUBLIC_ID_BRANCH=1
EXPO_PUBLIC_ID_CUENTA=1
