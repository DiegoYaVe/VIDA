# Copiar a .env y ajustar. Expo carga este archivo automáticamente (SDK 49+).
# Solo aplica a `expo start` local (dev build); los APKs de EAS usan el env de eas.json.
# Backend local: usa la IP LAN de tu máquina. Backend de producción: la URL pública.
EXPO_PUBLIC_API_URL=https://app.comercializadoravida.com/api
EXPO_PUBLIC_WS_URL=wss://app.comercializadoravida.com/api/ws
EXPO_PUBLIC_ID_BRANCH=1
EXPO_PUBLIC_ID_CUENTA=1

# Llave de Google Maps SDK for Android (restringida a este paquete + SHA-1 de
# EAS). Sin ella el APK usa el mapa VIDA sobre OpenStreetMap. Para los builds
# de EAS se define como variable de entorno del proyecto (ver DESPLIEGUE-VIDA.md).
GOOGLE_MAPS_ANDROID_KEY=
