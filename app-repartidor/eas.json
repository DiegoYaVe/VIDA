{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.comercializadoravida.com/api",
        "EXPO_PUBLIC_WS_URL": "wss://api.comercializadoravida.com/api/ws",
        "EXPO_PUBLIC_ID_BRANCH": "1",
        "EXPO_PUBLIC_ID_CUENTA": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.comercializadoravida.com/api",
        "EXPO_PUBLIC_WS_URL": "wss://api.comercializadoravida.com/api/ws",
        "EXPO_PUBLIC_ID_BRANCH": "1",
        "EXPO_PUBLIC_ID_CUENTA": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.comercializadoravida.com/api",
        "EXPO_PUBLIC_WS_URL": "wss://api.comercializadoravida.com/api/ws",
        "EXPO_PUBLIC_ID_BRANCH": "1",
        "EXPO_PUBLIC_ID_CUENTA": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
