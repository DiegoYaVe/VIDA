# Copiar a .env y ajustar según el entorno
# Desarrollo local (valores por defecto si no se define nada):
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001/api/ws

# Producción (ejemplo):
# VITE_API_URL=https://api.tudominio.com/api
# VITE_WS_URL=wss://api.tudominio.com/api/ws

# Google Maps JavaScript API — requerida para el selector de ubicación de
# Nueva tienda (Sucursales) y el mapa de Logística. Sin esta key esos mapas no
# cargan. Restringe la key a "Maps JavaScript API" y a los dominios del panel.
# Se inyecta en build time, así que debe estar presente al correr `npm run build`.
VITE_GOOGLE_MAPS_KEY=
