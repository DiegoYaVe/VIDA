# Producción — el frontend web habla con el backend de site18
# (Vite usa este archivo automáticamente en `npm run build`)
VITE_API_URL=http://israceballos-001-site18.mtempurl.com/api
VITE_WS_URL=ws://israceballos-001-site18.mtempurl.com/api/ws

# Key WEB de Google Maps (Maps JavaScript API). Debe ser una key de tipo
# navegador restringida por dominio — la key de Android NO sirve aquí.
# Si se deja vacía, el mapa del panel usa OpenStreetMap gratis.
VITE_GOOGLE_MAPS_KEY=
