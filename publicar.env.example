# Datos que usa publicar.bat para subir a produccion por FTP.
# Copia este archivo como publicar.env y completalo. publicar.env NO se
# commitea (.gitignore ya ignora *.env): lleva la clave del FTP.
#
#   copy publicar.env.example publicar.env
#
# Formato CLAVE=valor, sin comillas y sin espacios alrededor del =.

# Esquema: ftp (sin cifrar), ftpes (TLS explicito, lo normal en SmarterASP)
# o ftps (TLS implicito, puerto 990).
FTP_ESQUEMA=ftpes
FTP_PUERTO=21

FTP_HOST=
FTP_USUARIO=
FTP_PASSWORD=

# Si la clave trae caracteres que el .bat no digiere bien (! o ^), dejala en
# un archivo de texto aparte (fuera del repo) y pon aqui su ruta en vez de
# FTP_PASSWORD:
# FTP_PASSWORD_ARCHIVO=C:\Users\tu-usuario\vida-ftp.txt

# Carpeta remota de cada sitio, tal como la ve el FTP. Conectate una vez con
# un cliente FTP para confirmarlas antes de publicar: si apuntan mal, los
# archivos terminan en un sitio equivocado.
REMOTO_BACKEND=/
REMOTO_PANEL=/

# Backend y panel son dos sitios distintos (api. y app.), asi que pueden
# tener cuentas FTP distintas. Si es asi, descomenta lo que haga falta: lo
# que no se defina aqui cae a los valores generales de arriba.
# FTP_HOST_BACKEND=
# FTP_USUARIO_BACKEND=
# FTP_PASSWORD_BACKEND=
# FTP_HOST_PANEL=
# FTP_USUARIO_PANEL=
# FTP_PASSWORD_PANEL=

# Para la comprobacion posterior y el aviso final.
URL_HEALTH=https://api.comercializadoravida.com/api/health
URL_PANEL=https://app.comercializadoravida.com
